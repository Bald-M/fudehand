{
  "description": "浏览器启动器（scripts/launcher.mjs）与原生 App（AtlasCore/Catalog.swift）共用的 catalog 校验用例。新增或修改校验规则时，在这里补充用例，两端测试都会执行。工作区包含 apps/atlas、examples/demo，以及指向项目外目录的符号链接 examples/outside-link。error 为 null 表示配置有效，否则两端的错误信息都必须包含该文本。",
  "catalog": {
    "version": 1,
    "shell": { "port": 4400, "url": "http://127.0.0.1:4400/" },
    "projects": [
      {
        "id": "demo",
        "title": "演示",
        "subtitle": "",
        "description": "",
        "author": "原创",
        "sourceUrl": null,
        "framework": "HTML",
        "tags": [],
        "enabled": true,
        "layoutVersion": 1,
        "preview": { "cwd": "examples/demo", "command": ["pnpm", "dev"], "port": 4401, "baseUrl": "http://127.0.0.1:4401/demo/" },
        "frames": [
          { "id": "mobile", "title": "移动端", "platform": "mobile", "path": "home?view=mobile#top", "width": 390, "height": 844, "x": 0, "y": 0 },
          { "id": "web", "title": "网页端", "platform": "web", "path": "/?view=web", "width": 1440, "height": 900, "x": 470, "y": 0 }
        ]
      }
    ]
  },
  "cases": [
    { "name": "基准配置有效", "ops": [], "error": null },
    { "name": "允许 HTTPS 出处", "ops": [{ "op": "set", "path": ["projects", 0, "sourceUrl"], "value": "https://example.com/work" }], "error": null },
    { "name": "允许停用作品", "ops": [{ "op": "set", "path": ["projects", 0, "enabled"], "value": false }], "error": null },
    { "name": "允许 IPv6 本机地址", "ops": [{ "op": "set", "path": ["projects", 0, "preview", "baseUrl"], "value": "http://[::1]:4401/" }], "error": null },
    { "name": "版本必须为 1", "ops": [{ "op": "set", "path": ["version"], "value": 2 }], "error": "version" },
    { "name": "外壳端口不能是小数", "ops": [{ "op": "set", "path": ["shell", "port"], "value": 4400.5 }], "error": "port" },
    { "name": "预览端口不能是小数", "ops": [{ "op": "set", "path": ["projects", 0, "preview", "port"], "value": 4401.5 }], "error": "port" },
    { "name": "版本不能是小数", "ops": [{ "op": "set", "path": ["version"], "value": 1.5 }], "error": "version" },
    { "name": "外壳端口越界", "ops": [{ "op": "set", "path": ["shell", "port"], "value": 0 }], "error": "shell.port" },
    { "name": "外壳只能使用本机 HTTP", "ops": [{ "op": "set", "path": ["shell", "url"], "value": "https://127.0.0.1:4400/" }], "error": "本机 HTTP" },
    { "name": "作品 id 重复", "ops": [{ "op": "appendCopy", "path": ["projects"], "index": 0 }], "error": "id" },
    { "name": "作品 id 格式", "ops": [{ "op": "set", "path": ["projects", 0, "id"], "value": "Bad ID" }], "error": "id" },
    { "name": "标题不能为空白", "ops": [{ "op": "set", "path": ["projects", 0, "title"], "value": "  " }], "error": "title" },
    { "name": "标题必须是字符串", "ops": [{ "op": "set", "path": ["projects", 0, "title"], "value": 1 }], "error": "title" },
    { "name": "标签必须是字符串数组", "ops": [{ "op": "set", "path": ["projects", 0, "tags"], "value": [123] }], "error": "tags" },
    { "name": "缺少标签", "ops": [{ "op": "remove", "path": ["projects", 0, "tags"] }], "error": "tags" },
    { "name": "缺少出处字段", "ops": [{ "op": "remove", "path": ["projects", 0, "sourceUrl"] }], "error": "sourceUrl" },
    { "name": "缺少启用状态", "ops": [{ "op": "remove", "path": ["projects", 0, "enabled"] }], "error": "enabled" },
    { "name": "缺少预览配置", "ops": [{ "op": "remove", "path": ["projects", 0, "preview"] }], "error": "preview" },
    { "name": "布局版本必须为正整数", "ops": [{ "op": "set", "path": ["projects", 0, "layoutVersion"], "value": 0 }], "error": "layoutVersion" },
    { "name": "布局版本不能是小数", "ops": [{ "op": "set", "path": ["projects", 0, "layoutVersion"], "value": 1.5 }], "error": "layoutVersion" },
    { "name": "出处不能是脚本地址", "ops": [{ "op": "set", "path": ["projects", 0, "sourceUrl"], "value": "javascript:alert(1)" }], "error": "sourceUrl" },
    { "name": "出处必须有主机", "ops": [{ "op": "set", "path": ["projects", 0, "sourceUrl"], "value": "https://" }], "error": "sourceUrl" },
    { "name": "停用作品的端口也不能重复", "ops": [{ "op": "set", "path": ["projects", 0, "preview", "port"], "value": 4400 }, { "op": "set", "path": ["projects", 0, "enabled"], "value": false }], "error": "重复" },
    { "name": "预览只能使用本机 HTTP", "ops": [{ "op": "set", "path": ["projects", 0, "preview", "baseUrl"], "value": "http://example.com:4401/" }], "error": "本机 HTTP" },
    { "name": "预览地址端口一致", "ops": [{ "op": "set", "path": ["projects", 0, "preview", "baseUrl"], "value": "http://127.0.0.1:4402/" }], "error": "端口" },
    { "name": "预览地址不能含账号", "ops": [{ "op": "set", "path": ["projects", 0, "preview", "baseUrl"], "value": "http://user@127.0.0.1:4401/" }], "error": "账号" },
    { "name": "目录不能越界", "ops": [{ "op": "set", "path": ["projects", 0, "preview", "cwd"], "value": "../outside" }], "error": "cwd" },
    { "name": "目录必须存在", "ops": [{ "op": "set", "path": ["projects", 0, "preview", "cwd"], "value": "examples/missing" }], "error": "cwd" },
    { "name": "目录不能经符号链接离开项目", "ops": [{ "op": "set", "path": ["projects", 0, "preview", "cwd"], "value": "examples/outside-link" }], "error": "cwd" },
    { "name": "命令不能为空", "ops": [{ "op": "set", "path": ["projects", 0, "preview", "command"], "value": [] }], "error": "command" },
    { "name": "命令不能含空字符", "ops": [{ "op": "set", "path": ["projects", 0, "preview", "command"], "value": ["pnpm", "bad\u0000command"] }], "error": "command" },
    { "name": "至少一个画框", "ops": [{ "op": "set", "path": ["projects", 0, "frames"], "value": [] }], "error": "画框" },
    { "name": "画框 id 重复", "ops": [{ "op": "appendCopy", "path": ["projects", 0, "frames"], "index": 0 }], "error": "id" },
    { "name": "画框平台", "ops": [{ "op": "set", "path": ["projects", 0, "frames", 0, "platform"], "value": "tv" }], "error": "platform" },
    { "name": "画框宽度为正", "ops": [{ "op": "set", "path": ["projects", 0, "frames", 0, "width"], "value": 0 }], "error": "宽高" },
    { "name": "画框路径不能为空", "ops": [{ "op": "set", "path": ["projects", 0, "frames", 0, "path"], "value": "" }], "error": "path" },
    { "name": "画框路径不能换主机", "ops": [{ "op": "set", "path": ["projects", 0, "frames", 0, "path"], "value": "//example.com/escape" }], "error": "path" },
    { "name": "画框路径不能换端口", "ops": [{ "op": "set", "path": ["projects", 0, "frames", 0, "path"], "value": "http://127.0.0.1:4402/escape" }], "error": "path" },
    { "name": "反斜杠路径不能换主机", "ops": [{ "op": "set", "path": ["projects", 0, "frames", 0, "path"], "value": "\\\\example.com/escape" }], "error": "path" }
  ]
}

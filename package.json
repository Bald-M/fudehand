{
  "name": "ui-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/native-dev.mjs",
    "dev:web": "node scripts/dev.mjs",
    "build:native": "node scripts/native-build.mjs",
    "test:native": "node scripts/native-test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
